{
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "name": "Focus Minimal Dark",
  "colors": {
    "editor.foreground": "#E0E0E0",
    "editor.background": "#1A1A1A",
    "editorLineNumber.foreground": "#4D4D4D",
    "editorCursor.foreground": "#66CFFF",
    "editorWhitespace.foreground": "#2F2F2F",
    "editorIndentGuide.background1": "#2A2A2A",
    "editorIndentGuide.activeBackground1": "#3A3A3A",
    "sideBar.background": "#252525",
    "sideBar.foreground": "#DDDDDD",
    "activityBar.background": "#1E1E1E",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#777777",
    "titleBar.activeBackground": "#1A1A1A",
    "titleBar.activeForeground": "#E0E0E0",
    "titleBar.inactiveBackground": "#222222",
    "titleBar.inactiveForeground": "#888888",
    "statusBar.background": "#1E1E1E",
    "statusBar.foreground": "#CCCCCC",
    "statusBar.debuggingBackground": "#5AB8FF",
    "statusBar.debuggingForeground": "#000000",
    "statusBar.noFolderBackground": "#1E1E1E",
    "statusBar.noFolderForeground": "#CCCCCC",
    "statusBarItem.hoverBackground": "#3A3A3A",
    "statusBarItem.activeBackground": "#5AB8FF55",
    "statusBarItem.prominentBackground": "#5AB8FF",
    "statusBarItem.prominentHoverBackground": "#79C8FF",
    "statusBar.border": "#2A2A2A",
    "tab.activeBackground": "#1A1A1A",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#2A2A2A",
    "tab.inactiveForeground": "#888888",
    "panel.background": "#1E1E1E",
    "panel.border": "#333333",
    "scrollbarSlider.background": "#3A3A3A55",
    "scrollbarSlider.hoverBackground": "#3A3A3A88",
    "scrollbarSlider.activeBackground": "#3A3A3ACC",
    "editorGroupHeader.tabsBackground": "#1D1D1D",
    "editorGroup.border": "#2E2E2E"
  },
  "tokenColors": [
    {
      "scope": ["keyword", "keyword.control", "keyword.operator", "keyword.other", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#E0A060"
      }
    },
    {
      "scope": ["string", "constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant", "constant.other"],
      "settings": {
        "foreground": "#7CFF98"
      }
    },
    {
      "scope": ["entity.name.function", "meta.function.declaration", "meta.var.expr entity.name", "support.function", "entity.name.function.member", "meta.function-call"],
      "settings": {
        "foreground": "#66CFFF"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"],
      "settings": {
        "foreground": "#66CFFF"
      }
    },
    {
      "scope": ["variable.parameter", "meta.parameters variable", "variable.other.property", "variable.other.object.property", "meta.property-name"],
      "settings": {
        "foreground": "#C8C8C8"
      }
    },
    {
      "scope": ["variable.other.readwrite", "variable.other"],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "scope": ["comment.line", "comment.block", "comment.block.documentation"],
      "settings": {
        "foreground": "#666666"
      }
    },
    {
      "scope": ["comment.todo", "comment.fixme", "comment.note"],
      "settings": {
        "foreground": "#FFD466"
      }
    },
    {
      "scope": ["string.regexp", "source.regexp"],
      "settings": {
        "foreground": "#7CFF98"
      }
    },
    {
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#707070"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FF5C5C",
        "fontStyle": "underline"
      }
    }
  ]
}