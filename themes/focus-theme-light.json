{
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "name": "Focus Minimal Light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#333333",
    "editorLineNumber.foreground": "#BBBBBB",
    "editorCursor.foreground": "#0077CC",
    "editorWhitespace.foreground": "#E6E6E6",
    "sideBar.background": "#F7F7F7",
    "sideBar.foreground": "#333333",
    "activityBar.background": "#F2F2F2",
    "activityBar.foreground": "#222222",
    "tab.activeBackground": "#FFFFFF",
    "tab.inactiveBackground": "#EDEDED",
    "tab.activeForeground": "#222222",
    "tab.inactiveForeground": "#777777",
    "statusBar.background": "#F7F7F7",
    "statusBar.foreground": "#333333",
    "statusBar.noFolderBackground": "#FFFFFF",
    "statusBar.noFolderForeground": "#666666",
    "statusBarItem.hoverBackground": "#E0E0E0",
    "statusBarItem.activeBackground": "#0077CC22",
    "statusBarItem.prominentBackground": "#0077CC",
    "statusBarItem.prominentHoverBackground": "#2299FF",
    "statusBar.border": "#DADADA",
    "panel.background": "#FAFAFA",
    "panel.border": "#E4E4E4",
    "editorIndentGuide.background1": "#E6E6E6",
    "editorIndentGuide.activeBackground1": "#D8D8D8",
    "editorGroupHeader.tabsBackground": "#F7F7F7",
    "editorGroup.border": "#DDDDDD",
    "scrollbarSlider.background": "#CFCFCF55",
    "scrollbarSlider.hoverBackground": "#CFCFCF88",
    "scrollbarSlider.activeBackground": "#CFCFCFCC",
    "titleBar.activeBackground": "#FFFFFF",
    "titleBar.activeForeground": "#222222",
    "titleBar.inactiveBackground": "#F0F0F0",
    "titleBar.inactiveForeground": "#777777"
  },
  "tokenColors": [
    {
      "scope": ["keyword", "keyword.control", "keyword.operator", "keyword.other", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#B06040"
      }
    },
    {
      "scope": ["string", "constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant", "constant.other"],
      "settings": {
        "foreground": "#22863A"
      }
    },
    {
      "scope": ["entity.name.function", "meta.function.declaration", "meta.var.expr entity.name", "support.function", "entity.name.function.member", "meta.function-call"],
      "settings": {
        "foreground": "#0077CC"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"],
      "settings": {
        "foreground": "#0077CC"
      }
    },
    {
      "scope": ["variable.parameter", "meta.parameters variable", "variable.other.property", "variable.other.object.property", "meta.property-name"],
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "scope": ["variable.other.readwrite", "variable.other"],
      "settings": {
        "foreground": "#444444"
      }
    },
    {
      "scope": ["comment.line", "comment.block", "comment.block.documentation"],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "scope": ["comment.todo", "comment.fixme", "comment.note"],
      "settings": {
        "foreground": "#B8860B"
      }
    },
    {
      "scope": ["string.regexp", "source.regexp"],
      "settings": {
        "foreground": "#22863A"
      }
    },
    {
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#666666"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#CC0000",
        "fontStyle": "underline"
      }
    }
  ]
}